diff --git a/src/breeze-transparent-gtk-opacity b/src/breeze-transparent-gtk-opacity
new file mode 100755
index 0000000..5ab1141
--- /dev/null
+++ b/src/breeze-transparent-gtk-opacity
@@ -0,0 +1,110 @@
+#!/bin/sh
+# Set the window background opacity of the Breeze-Transparent GTK themes for the current user.
+#
+# The themes define their translucent colors as named colors, which the user GTK 3 and GTK 4
+# stylesheets can redefine. This writes those definitions to breeze-transparent.css next to
+# gtk.css, and imports it from gtk.css (the rest of gtk.css is left untouched).
+set -eu
+
+name=$(basename "$0")
+config_home=${XDG_CONFIG_HOME:-$HOME/.config}
+override=breeze-transparent.css
+import_line="@import url(\"$override\");"
+
+usage() {
+    cat <<EOF
+Usage: $name OPACITY
+       $name reset
+       $name show
+
+Set the window background opacity of the Breeze-Transparent GTK themes, for the current user.
+
+  OPACITY   opacity in percent, from 0 (fully transparent) to 100 (opaque)
+  reset     remove the override, going back to the opacity the themes were built with
+  show      print the current override
+
+Running applications need to be restarted.
+EOF
+}
+
+# write stdin to a file, following symlinks (e.g. gtk.css managed as a dotfile)
+write_file() {
+    tmp=$(mktemp)
+    cat > "$tmp"
+    cat "$tmp" > "$1"
+    rm -f "$tmp"
+}
+
+set_opacity() {
+    alpha=$(awk -v value="$1" 'BEGIN { printf "%g", value / 100 }')
+
+    for version in gtk-3.0 gtk-4.0; do
+        dir="$config_home/$version"
+        mkdir -p "$dir"
+
+        write_file "$dir/$override" <<EOF
+/* Generated by $name, changes will be overwritten. Window background opacity: $1% */
+@define-color theme_bg_color_translucent_breeze alpha(@theme_bg_color_breeze, $alpha);
+@define-color theme_unfocused_bg_color_translucent_breeze alpha(@theme_unfocused_bg_color_breeze, $alpha);
+@define-color theme_titlebar_background_translucent_breeze alpha(@theme_titlebar_background_breeze, $alpha);
+@define-color theme_titlebar_background_backdrop_translucent_breeze alpha(@theme_titlebar_background_backdrop_breeze, $alpha);
+EOF
+
+        # @import rules must come before anything else: add ours at the top
+        css="$dir/gtk.css"
+        if [ ! -e "$css" ]; then
+            echo "$import_line" > "$css"
+        elif ! grep -qxF "$import_line" "$css"; then
+            { echo "$import_line"; cat "$css"; } | write_file "$css"
+        fi
+    done
+
+    echo "Window background opacity set to $1%. Restart GTK applications to apply it."
+}
+
+reset_opacity() {
+    for version in gtk-3.0 gtk-4.0; do
+        dir="$config_home/$version"
+        rm -f "$dir/$override"
+        if [ -e "$dir/gtk.css" ] && grep -qxF "$import_line" "$dir/gtk.css"; then
+            grep -vxF "$import_line" "$dir/gtk.css" | write_file "$dir/gtk.css" || true
+        fi
+    done
+
+    echo "Opacity override removed. Restart GTK applications to apply it."
+}
+
+show_opacity() {
+    for version in gtk-3.0 gtk-4.0; do
+        file="$config_home/$version/$override"
+        if [ -e "$file" ]; then
+            value=$(sed -n 's/.*Window background opacity: \([0-9]*\)%.*/\1/p' "$file")
+            echo "$version: ${value:-?}%"
+        else
+            echo "$version: not set (build default)"
+        fi
+    done
+}
+
+case "${1:-}" in
+    -h|--help) usage ;;
+    reset) reset_opacity ;;
+    show) show_opacity ;;
+    '')
+        usage >&2
+        exit 1
+        ;;
+    *)
+        case "$1" in
+            *[!0-9]*)
+                echo "$name: invalid opacity '$1', expected an integer between 0 and 100" >&2
+                exit 1
+                ;;
+        esac
+        if [ "$1" -gt 100 ]; then
+            echo "$name: invalid opacity '$1', expected an integer between 0 and 100" >&2
+            exit 1
+        fi
+        set_opacity "$1"
+        ;;
+esac
