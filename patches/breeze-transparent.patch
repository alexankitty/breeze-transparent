+//________________________________________________________________
+void Decoration::updateTranslucency()
+{
+    const bool translucent = backgroundOpacity() < 1.0;
+
+    // only claim to be opaque when the titlebar is actually painted opaque
+    setOpaque(isMaximized() && !translucent);
+
+    if (!(translucent && m_internalSettings->windowBlurEnabled())) {
+        setBlurRegion(QRegion());
+        return;
+    }
+
+    // blur behind the whole decoration, following its rounded corners.
+    // KWin only uses the part of the region that lies outside the client area
+    const QRectF decorationRect(rect());
+    if (isMaximized() || hasNoBorders() || m_scaledCornerRadius <= 0) {
+        setBlurRegion(QRegion(decorationRect.toAlignedRect()));
+    } else {
+        QPainterPath path;
+        path.addRoundedRect(decorationRect, m_scaledCornerRadius, m_scaledCornerRadius);
+        setBlurRegion(QRegion(path.toFillPolygon().toPolygon()));
+    }
 }
 
