+//____________________________________________________________________________________
+bool Style::isTranslucentWindowCandidate(const QWidget *widget) const
+{
+#ifdef Q_OS_WIN
+    // would require frameless windows
+    Q_UNUSED(widget)
+    return false;
+#else
+    if (!(widget && widget->isWindow())) {
+        return false;
+    }
+
+    // feature disabled. Enabling it requires restarting applications, since the alpha channel
+    // must be requested before native windows are created
+    if (StyleConfigData::windowOpacity() >= 100 || !_helper->compositingActive()) {
+        return false;
+    }
+
+    // only regular application windows and dialogs. Menus, tooltips, tool windows, etc. are left alone
+    if (!(qobject_cast<const QMainWindow *>(widget) || qobject_cast<const QDialog *>(widget))) {
+        return false;
+    }
+
+    const auto type(widget->windowType());
+    if (type != Qt::Window && type != Qt::Dialog) {
+        return false;
+    }
+
+    // explicitly opted out
+    if (widget->property(PropertyNames::noWindowTranslucency).toBool()) {
+        return false;
+    }
+
+    // applications that manage the window background themselves
+    if (widget->testAttribute(Qt::WA_TranslucentBackground) || widget->testAttribute(Qt::WA_NoSystemBackground)
+        || widget->testAttribute(Qt::WA_PaintOnScreen) || widget->autoFillBackground() || !widget->styleSheet().isEmpty()) {
+        return false;
+    }
+
+    // too late once shown. Before that, the native window can still be recreated, see polishTranslucentWindow
+    if (widget->isVisible()) {
+        return false;
+    }
+
+    if (const auto window = widget->windowHandle()) {
+        if (window->isVisible() || window->surfaceType() != QSurface::RasterSurface) {
+            return false;
+        }
+    }
+
+    // per-application opt out
+    const auto blackList(StyleConfigData::windowOpacityBlackList());
+    if (!blackList.isEmpty()) {
+        const auto applicationName(QCoreApplication::applicationName());
+        const auto executableName(QFileInfo(QCoreApplication::applicationFilePath()).fileName());
+        for (const auto &entry : blackList) {
+            const auto name(entry.trimmed());
+            if (!name.isEmpty() && (name.compare(applicationName, Qt::CaseInsensitive) == 0 || name == executableName)) {
+                return false;
+            }
+        }
+    }
+
+    return true;
+#endif
+}
+
+//____________________________________________________________________________________
+void Style::polishTranslucentWindow(QWidget *widget)
+{
+    widget->setProperty(PropertyNames::translucentWindow, true);
+    widget->setAttribute(Qt::WA_TranslucentBackground);
+
+    /*
+    WA_TranslucentBackground implies WA_NoSystemBackground, which prevents Qt from painting
+    the (styled) window background altogether. Re-enable it, the translucent background
+    is then rendered in drawWidgetPrimitive
+    */
+    widget->setAttribute(Qt::WA_NoSystemBackground, false);
+    widget->setAttribute(Qt::WA_StyledBackground);
+
+    /*
+    QWidget::setVisible() creates the native window before polishing the widget, at which point
+    setting WA_TranslucentBackground no longer affects the window format. The window is not shown yet,
+    so recreate its platform window with an alpha channel. The QWindow itself (and its state) is kept,
+    and the widget follows through QPlatformSurfaceEvent
+    */
+    if (auto window = widget->windowHandle(); window && window->handle()) {
+        window->destroy();
+        auto format(window->requestedFormat());
+        format.setAlphaBufferSize(8);
+        window->setFormat(format);
+        window->create();
+    }
+
+    _blurHelper->registerWidget(widget);
+}
+
+//____________________________________________________________________________________
+qreal Style::windowBackgroundOpacity(const QWidget *widget) const
+{
+    if (!widget) {
+        return 1.0;
+    }
+
+    const auto window(widget->window());
+    if (!(window && window->property(PropertyNames::translucentWindow).toBool()) || window->isFullScreen()) {
+        return 1.0;
+    }
+
+    return std::clamp(StyleConfigData::windowOpacity(), 0, 100) / 100.0;
+}
+
+//____________________________________________________________________________________
+void Style::renderTranslucentWindowBackground(QPainter *painter, const QRect &rect, const QWidget *widget) const
+{
+    auto color(widget->palette().color(widget->isActiveWindow() ? QPalette::Active : QPalette::Inactive, QPalette::Window));
+    color.setAlphaF(color.alphaF() * windowBackgroundOpacity(widget));
+
+    painter->save();
+    painter->setCompositionMode(QPainter::CompositionMode_Source);
+    painter->fillRect(rect, color);
+    painter->restore();
+}
+
+//____________________________________________________________________________________
+bool Style::eventFilterTranslucentContent(QWidget *widget, QPaintEvent *event)
+{
+    if (widget->isWindow() || widget == _translucentContentWidget) {
+        return false;
+    }
+
+    const qreal opacity(windowBackgroundOpacity(widget));
+    if (opacity >= 1.0) {
+        return false;
+    }
+
+    const bool translucentViews(StyleConfigData::translucentViews());
+    if (translucentViews && isOpaqueContentWidget(widget)) {
+        return paintTranslucentContent(widget, event, opacity);
+    }
+
+    /*
+    Widgets filling their background (e.g. item view and text edit viewports): Qt already painted it opaque
+    on top of the translucent window background, replace it with its translucent counterpart before the
+    widget paints its contents
+    */
+    if (!widget->autoFillBackground() || widget->testAttribute(Qt::WA_NativeWindow)) {
+        return false;
+    }
+
+    const auto role(widget->backgroundRole());
+    if (!(role == QPalette::Window || (translucentViews && (role == QPalette::Base || role == QPalette::AlternateBase)))) {
+        return false;
+    }
+
+    // only opaque fills hide the window background. Translucent ones are left alone
+    const auto brush(widget->palette().brush(role));
+    if (brush.style() != Qt::SolidPattern || !brush.isOpaque()) {
+        return false;
+    }
+
+    auto color(brush.color());
+    color.setAlphaF(color.alphaF() * opacity);
+
+    QPainter painter(widget);
+    painter.setClipRegion(event->region());
+    painter.setCompositionMode(QPainter::CompositionMode_Source);
+    painter.fillRect(widget->rect(), color);
+    return false;
+}
+
+//____________________________________________________________________________________
+bool Style::isOpaqueContentWidget(const QWidget *widget) const
+{
+    // KTextEditor paints its background from its own color theme
+    if (widget->inherits("KateViewInternal") || widget->inherits("KateIconBorder") || widget->inherits("KateScrollBar")) {
+        return true;
+    }
+
+    // Dolphin paints alternating row backgrounds itself
+    if (const auto parent = widget->parentWidget(); parent && parent->inherits("KItemListContainerViewport")) {
+        return true;
+    }
+
+    return false;
+}
+
+//____________________________________________________________________________________
+bool Style::paintTranslucentContent(QWidget *widget, QPaintEvent *event, qreal opacity)
+{
+    /*
+    find out where the widget is being painted: the window backing store, or an image the widget
+    is rendered into. Anything else (e.g. pixmaps) is painted normally
+    */
+    QImage *image = nullptr;
+    QTransform transform;
+    {
+        QPainter probe(widget);
+        if (!probe.isActive()) {
+            return false;
+        }
+
+        auto device(probe.paintEngine()->paintDevice());
+        if (!device || device->devType() != QInternal::Image) {
+            return false;
+        }
+
+        image = static_cast<QImage *>(device);
+        transform = probe.deviceTransform();
+    }
+
+    if (image->format() != QImage::Format_ARGB32_Premultiplied) {
+        return false;
+    }
+
+    /*
+    let the widget paint itself, then process the pixels it painted. The event is sent again rather than
+    passed to the widget directly, so that event filters painting on its behalf (e.g. scroll area viewports)
+    are honored
+    */
+    _translucentContentWidget = widget;
+    QCoreApplication::sendEvent(widget, event);
+    _translucentContentWidget = nullptr;
+
+    QList<QRect> rects;
+    for (const QRect &rect : event->region()) {
+        const QRect deviceRect(transform.mapRect(QRectF(rect)).toAlignedRect() & image->rect());
+        if (!deviceRect.isEmpty()) {
+            rects.append(deviceRect);
+        }
+    }
+
+    if (rects.isEmpty()) {
+        return true;
+    }
+
+    /*
+    background color. Widgets filling their background (e.g. Dolphin's view) use their palette color.
+    Others paint it from their own settings (e.g. the text editor color theme): it is then sampled as the
+    most frequent color of full repaints. Once known, it only changes when it disappeared from the widget
+    altogether (e.g. after a color theme change), so that large selections or highlights never take over
+    */
+    static const char keyColorProperty[] = "_breeze_translucent_content_key";
+    QRgb key(0);
+    if (widget->autoFillBackground()) {
+        key = widget->palette().color(widget->backgroundRole()).rgba();
+    } else {
+        const auto stored(widget->property(keyColorProperty));
+        if (stored.isValid()) {
+            key = stored.toUInt();
+        }
+
+        if (event->region() == QRegion(widget->rect())) {
+            const QRect deviceBounds(transform.mapRect(QRectF(widget->rect())).toAlignedRect() & image->rect());
+            QHash<QRgb, int> counts;
+            const int steps = 16;
+            for (int i = 0; i < steps; ++i) {
+                const QRgb *line = reinterpret_cast<const QRgb *>(image->constScanLine(deviceBounds.top() + (deviceBounds.height() - 1) * i / (steps - 1)));
+                for (int j = 0; j < steps; ++j) {
+                    const QRgb pixel(line[deviceBounds.left() + (deviceBounds.width() - 1) * j / (steps - 1)]);
+                    if (qAlpha(pixel) == 255) {
+                        ++counts[pixel];
+                    }
+                }
+            }
+
+            if (!stored.isValid() || !counts.contains(key)) {
+                int best = 0;
+                for (auto it = counts.cbegin(); it != counts.cend(); ++it) {
+                    if (it.value() > best) {
+                        best = it.value();
+                        key = it.key();
+                    }
+                }
+
+                if (best > 0) {
+                    widget->setProperty(keyColorProperty, uint(key));
+                }
+            }
+        }
+    }
+
+    if (qAlpha(key) != 255) {
+        return true;
+    }
+
+    /*
+    "color to alpha": each opaque pixel P is considered as some color F with coverage c, blended
+    over the background color B, with the smallest possible c. The pixel is then re-composited over
+    the background at the window opacity: text keeps its color, the background becomes translucent,
+    and colors close to the background (current line, alternating rows...) partially so
+    */
+    const int keyChannels[3] = {qRed(key), qGreen(key), qBlue(key)};
+    const QRgb keyTranslucent(qRgba(qRound(keyChannels[0] * opacity), qRound(keyChannels[1] * opacity), qRound(keyChannels[2] * opacity), qRound(255 * opacity)));
+
+    for (const QRect &rect : std::as_const(rects)) {
+        for (int y = rect.top(); y <= rect.bottom(); ++y) {
+            QRgb *line = reinterpret_cast<QRgb *>(image->scanLine(y));
+            for (int x = rect.left(); x <= rect.right(); ++x) {
+                const QRgb pixel(line[x]);
+                if (pixel == key) {
+                    line[x] = keyTranslucent;
+                    continue;
+                }
+
+                if (qAlpha(pixel) != 255) {
+                    continue;
+                }
+
+                const int channels[3] = {qRed(pixel), qGreen(pixel), qBlue(pixel)};
+                qreal coverage = 0;
+                for (int c = 0; c < 3; ++c) {
+                    if (channels[c] > keyChannels[c]) {
+                        coverage = std::max(coverage, qreal(channels[c] - keyChannels[c]) / (255 - keyChannels[c]));
+                    } else if (channels[c] < keyChannels[c]) {
+                        coverage = std::max(coverage, qreal(keyChannels[c] - channels[c]) / keyChannels[c]);
+                    }
+                }
+
+                if (coverage >= 1.0) {
+                    continue;
+                }
+
+                // background contribution that becomes transparent
+                const qreal removed((1.0 - coverage) * (1.0 - opacity));
+                line[x] = qRgba(std::clamp(qRound(channels[0] - removed * keyChannels[0]), 0, 255),
+                                std::clamp(qRound(channels[1] - removed * keyChannels[1]), 0, 255),
+                                std::clamp(qRound(channels[2] - removed * keyChannels[2]), 0, 255),
+                                qRound(255 * (1.0 - removed)));
+            }
+        }
+    }
+
+    return true;
+}
+
+//____________________________________________________________________________________
+bool Style::drawPanelItemViewRowPrimitive(const QStyleOption *option, QPainter *painter, const QWidget *widget) const
+{
+    // translucent windows: alternate rows replace the translucent view background rather than covering it
+    const auto viewItemOption(qstyleoption_cast<const QStyleOptionViewItem *>(option));
+    if (!(viewItemOption && (viewItemOption->features & QStyleOptionViewItem::Alternate) && StyleConfigData::translucentViews())) {
+        return false;
+    }
+
+    const qreal opacity(windowBackgroundOpacity(widget));
+    if (opacity >= 1.0) {
+        return false;
+    }
+
+    const auto group((widget ? widget->isEnabled() : (option->state & State_Enabled)) ? QPalette::Normal : QPalette::Disabled);
+    auto color(option->palette.color(group, QPalette::AlternateBase));
+    color.setAlphaF(color.alphaF() * opacity);
+
+    painter->setCompositionMode(QPainter::CompositionMode_Source);
+    painter->fillRect(option->rect, color);
+    return true;
+}
